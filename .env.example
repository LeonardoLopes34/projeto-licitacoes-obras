APP_ENV=development
DATABASE_URL=sqlite:///./licitacoes_obras.db
PNCP_MAX_CONCURRENT_REQUESTS=1
PNCP_REQUEST_INTERVAL_SECONDS=2
PNCP_RATE_LIMIT_RETRY_SECONDS=5
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_API_KEY=change-me-in-development
# Chave enviada pelo ERP no header X-API-Key. Vazia = API aberta (somente dev).
API_KEY=
PNCP_CA_BUNDLE=
PNCP_TIMEOUT_SECONDS=8
PNCP_CONNECT_TIMEOUT_SECONDS=3
PNCP_MAX_PAGINAS=1
PNCP_CACHE_TTL_SECONDS=180
PNCP_CACHE_MAXSIZE=256
PNCP_CIRCUIT_FAILURE_THRESHOLD=3
PNCP_CIRCUIT_OPEN_SECONDS=30
PAGINATION_CURSOR_SECRET=change-me-in-production
QUERY_SNAPSHOT_TTL_SECONDS=900
QUERY_SNAPSHOT_MAX_RECORDS=1000
QUERY_SNAPSHOT_MAX_BYTES=2097152
QUERY_SNAPSHOT_MAX_COUNT=256
RETENTION_DAYS=2
EDITAL_DOWNLOAD_CONNECT_TIMEOUT_SECONDS=5
EDITAL_DOWNLOAD_TIMEOUT_SECONDS=30
EDITAL_DOWNLOAD_RETRIES=2
EDITAL_DOWNLOAD_RETRY_DELAY_SECONDS=1
EDITAL_PDF_MAX_BYTES=20971520
EDITAL_PDF_MAX_PAGES=150
EDITAL_ZIP_MAX_ENTRIES=100
EDITAL_ZIP_MAX_PDFS=10
EDITAL_ZIP_MAX_UNCOMPRESSED_BYTES=62914560
EDITAL_ZIP_MAX_COMPRESSION_RATIO=100
EDITAL_ZIP_MAX_TOTAL_PAGES=150
EDITAL_TEXT_MIN_CHARACTERS=80
# Desligue temporariamente para testar somente texto digital e análise assistida.
EDITAL_OCR_ENABLED=true
EDITAL_OCR_DPI=250
EDITAL_OCR_LANGUAGE=por
EDITAL_OCR_TIMEOUT_SECONDS=45
# Exemplo Windows: C:\\Program Files\\Tesseract-OCR\\tesseract.exe
TESSERACT_CMD=
# OCR por IA: "openai" transcreve paginas escaneadas com modelo de visao (exige
# OPENAI_API_KEY) e usa o Tesseract como fallback. Ao trocar o provedor, mude
# EDITAL_ANALYZER_VERSION para nao reaproveitar analises feitas com o OCR antigo.
EDITAL_OCR_PROVIDER=tesseract
OPENAI_OCR_MODEL=gpt-5-mini
# Deixe vazio para modelos sem raciocinio (ex.: gpt-4.1-mini).
OPENAI_OCR_REASONING_EFFORT=minimal
OPENAI_OCR_MAX_OUTPUT_TOKENS=8000
EDITAL_ANALYSIS_CONCURRENCY=2
EDITAL_ANALYSIS_QUEUE_MAXSIZE=8
EDITAL_ANALYSIS_MAX_DOCUMENTS=20
EDITAL_ANALYSIS_MAX_TOTAL_BYTES=52428800
EDITAL_ANALYSIS_MAX_TOTAL_PAGES=300
EDITAL_ANALYSIS_CACHE_TTL_SECONDS=86400
EDITAL_ANALYSIS_CACHE_MAXSIZE=128
EDITAL_ANALYSIS_TIMEOUT_SECONDS=180
EDITAL_ANALYZER_VERSION=ocr-edital-v3
# Spec 015 — mantenha desligado até executar PostgreSQL com pgvector via
# `docker compose up -d postgres` e definir OPENAI_API_KEY apenas no .env local.
VECTOR_INDEXING_ENABLED=false
# DATABASE_URL=postgresql+psycopg2://licitacoes:licitacoes_dev_change_me@127.0.0.1:55432/licitacoes_obras
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
OPENAI_ANALYSIS_MODEL=gpt-5-mini
OPENAI_REQUEST_TIMEOUT_SECONDS=30
OPENAI_EMBEDDING_BATCH_SIZE=32
OPENAI_ANALYSIS_MAX_CHUNKS=48
OPENAI_ANALYSIS_MAX_INPUT_CHARACTERS=48000
OPENAI_ANALYSIS_MAX_OUTPUT_TOKENS=4096
OPENAI_ANALYSIS_MAX_ITEMS=50
VECTOR_CHUNK_MAX_CHARACTERS=1400
VECTOR_CHUNK_OVERLAP_CHARACTERS=160
VECTOR_INDEX_MAX_CHUNKS_PER_DOCUMENT=300
VECTOR_INDEX_MAX_CHUNKS_PER_JOB=800
VECTOR_INDEX_MAX_DOCUMENTS=20
VECTOR_INDEX_MAX_ATTEMPTS=3
VECTOR_INDEX_LEASE_SECONDS=300
VECTOR_INDEX_WORKER_CONCURRENCY=1
VECTOR_INDEX_MAX_COST_USD_PER_JOB=0.50
VECTOR_INDEX_RETENTION_DAYS=90
OPENAI_EMBEDDING_COST_PER_MILLION_TOKENS=0.02
OPENAI_ANALYSIS_INPUT_COST_PER_MILLION_TOKENS=0.25
OPENAI_ANALYSIS_OUTPUT_COST_PER_MILLION_TOKENS=2.00
VECTOR_CHUNKING_VERSION=chunking-v1
VECTOR_EXTRACTION_VERSION=pdf-ocr-v1
OPENAI_ANALYSIS_PROMPT_VERSION=requirements-v1
OPENAI_ANALYSIS_SCHEMA_VERSION=requirements-schema-v1
PNCP_DOCUMENT_HOSTS=pncp.gov.br,www.pncp.gov.br
VITE_API_URL=/api/v1
VITE_SANDBOX_URL=/sandbox.html
